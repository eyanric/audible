# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.ruff_cache/
.pyright/

# Secrets & runtime data
.env
data/cache/
# sim's own cache root -- see sim/__init__.py. Same reason as data/cache/: re-fetchable
# frames plus per-machine payloads. It exists so a sim run can never write the root a live
# cockpit is serving from.
data/sim-cache/
# News store. Collected, not re-fetchable (Rotowire serves five items), and it is
# per-machine history rather than anything the repo should carry.
data/news/
snapshots/
*.local

# FFA vintage projections. This repository is PUBLIC and these files are derived from a
# paid FFA Insider subscription, so the data itself is never committed -- only
# sim/data/ffa/README.md and the checksum manifest beside it. See that README before
# adding anything here.
sim/data/ffa/*.csv

# Personal draft exports (reconstructible from ESPN + the synced state file)
draft-*-results.md

# OS / editor
.DS_Store
.vscode/
.idea/
cheatsheets/

# Captured live-draft forensics. This repository is PUBLIC and these are Eric's own draft
# records and the pod's raw poll history -- personal data, and the log routinely runs to
# tens of MB. Gated the same way sim/data/ffa/*.csv is: the DERIVED, anonymised telemetry
# lives in tests/fixtures/espn_*_draft_window.json (statuses and counts, no player identity)
# and that is the only part that is ever committed.
green-hope-*.json
green-hope-*.log
*-pod.log
*-pod-prev.log
*-draft-state.json
