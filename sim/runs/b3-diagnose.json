#     oracle: +21.0 [-20.1, +62.2]
#     hindsight: +20.8 [-5.4, +47.0]
#   surface gap: +26.2 [-40.4, +92.8]
#     oracle: +36.7 [+3.7, +69.7]
#     hindsight: +47.9 [+20.7, +75.1]
#   real - shuffle: +91.9 [+65.1, +118.7]
#     oracle: +83.0 [+31.2, +134.8]
#     hindsight: +103.1 [+43.5, +162.8]
