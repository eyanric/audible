# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- ESPN (League B, private league 6012) ---
# From fantasy.espn.com browser cookies (DevTools -> Application -> Cookies).
# swid MUST keep its curly braces.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# --- Anthropic (Phase 3 reasoning layer) ---
ANTHROPIC_API_KEY=

# --- MCP server (Phase 3) ---
# Shared bearer token for the remote HTTP MCP endpoint behind the reverse proxy.
MCP_AUTH_TOKEN=
